# AWS / Bedrock. never commit a filled-in .env
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID_FAST=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID_STRONG=anthropic.claude-sonnet-4-5-20250929-v1:0

# LTA DataMall. required only by scripts/, never by the demo (see scenario-v1.md M3)
LTA_ACCOUNT_KEY=

# Study area. A town is a folder under data/lta/, produced by scripts/fetch_lta.py <town>.
# GEOGRAPHY=synthetic falls back to the invented estate in backend/app/geography.py.
TOWN=ang-mo-kio
GEOGRAPHY=real
