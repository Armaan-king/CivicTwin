# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# The shell wins over this file: an exported variable is not overridden by a line here.

# ---------------------------------------------------------------- model
# Residents deliberate through a model. There is no offline substitute: with
# LLM_PROVIDER=mock the deliberation refuses rather than producing text that reads
# like a resident and is not one.
# ollama | deepseek | groq | grok | bedrock.
# `ollama` runs a local model and needs no key. `deepseek` is hosted DeepSeek and
# needs DEEPSEEK_API_KEY. Note Groq and Grok are different companies whose names
# differ by one letter, and each rejects the other's key.
LLM_PROVIDER=ollama

# Local model through Ollama. No key: the endpoint is on loopback.
# Ollama's native /api/chat takes `format: <json schema>`, which constrains
# generation to the schema. That is why a local 8B model can return a batch of
# twelve residents at all -- asked politely it returns an empty list.
OLLAMA_MODEL_ID=deepseek-r1:8b
OLLAMA_URL=http://localhost:11434/api/chat

# Groq. Key from console.groq.com. Keep it in this backend file, never in VITE_*.
GROQ_API_KEY=
# Used for policy interpretation and batched resident deliberation.
GROQ_MODEL_ID=openai/gpt-oss-120b

# xAI, if you switch LLM_PROVIDER back to grok.
XAI_API_KEY=
GROK_MODEL_ID=grok-4.3

# ---------------------------------------------------------------- AWS Bedrock
# Claude through Amazon Bedrock. boto3 reads these directly; the names are the AWS CLI
# "Configuring environment variables" reference set.
#
# Two auth shapes, mutually exclusive:
#   A. SigV4 IAM pair. AWS_SESSION_TOKEN only for temporary credentials (STS / Identity
#      Center), which expire and are not permanent configuration.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
#   B. A Bedrock API key -- one bearer token, no pair. Use instead of the three above.
#      Needs boto3 >= 1.39.
# AWS_BEARER_TOKEN_BEDROCK=

# llm.py reads AWS_REGION; AWS_DEFAULT_REGION is the CLI's name for the same thing.
# Model access is granted per region, so these must match where access was granted.
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1

# Most Claude models on Bedrock are callable only through a regional inference profile,
# whose id carries a us. / eu. / apac. prefix and fails with a plain model id. Check:
#   aws bedrock list-foundation-models --by-provider anthropic #     --query "modelSummaries[].modelId"
BEDROCK_MODEL_ID_FAST=anthropic.claude-haiku-4-5-20251001-v1:0


# At 0 two thousand residents reason in one voice. Interpretation still uses 0.
DELIBERATION_TEMPERATURE=0.8

# How many residents deliberate. Unset or 0 means the whole town, which is the real
# product. A free Groq key allows 8,000 tokens a minute and one batch of 12 reserves
# most of that, so the whole town needs a paid tier. Raise this as your limit allows.
DELIBERATION_LIMIT=

# ---------------------------------------------------------------- study area
# A town is a folder under data/lta/, produced by scripts/fetch_lta.py <town>.
TOWN=ang-mo-kio
# real reads the LTA extract; synthetic uses the invented estate in geography.py
GEOGRAPHY=real

# ---------------------------------------------------------------- data
# Only needed to re-run scripts/fetch_lta.py. The app reads data/lta/ and never calls it.
# Free key by email: https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

# OneMap basemap tiles need no key; its search and routing APIs do.
ONEMAP_TOKEN=

# One local GPU serves one batch at a time; more workers only queue.
DELIBERATION_CONCURRENCY=

# Policy interpretation is one call per run against a wide schema, and getting it wrong
# makes every downstream number answer a different question. Point it at a stronger model
# than the per-resident deliberation (AGENTS.md 11). Unset, it follows LLM_PROVIDER.
LLM_PROVIDER_INTERPRETER=
