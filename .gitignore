# python
.venv/
__pycache__/
*.pyc

# node
node_modules/
dist/
.vite/

# env and secrets
.env
.env.local

# data: raw and processed are derived, fixtures are committed
data/raw/
data/processed/

# derived: copied from data/fixtures by frontend/scripts/sync-fixture.mjs
frontend/public/fixtures/

# tooling caches
.pytest_cache/
*.tsbuildinfo
.impeccable/

# reference checkouts. read-only: neither repo is licensed for reuse (AGENTS.md 10B)
testing/

# Model output cached by content hash. Machine-local: it is a record of what this machine
# paid for, not part of the project, and committing stub output would pass a test double's
# text off as a run.
# The cached model output IS the demo artefact: a run costs hours once and
# replays for free forever after (AGENTS.md 22). It is gitignored only because
# it is 45MB of machine-generated JSON and still holds entries from earlier
# stub and hosted-model runs. The readable, committed record of a run is
# data/runs/, written by scripts/export_run.py.
# Runtime state, not source. It records every ruling a human makes on a proposed
# correction, so it changes on every click and would otherwise put demo noise into
# every diff. Absent, it reads as empty -- which is the correct starting state.
data/calibration_state.json
data/deliberation_cache/
data/llm_cache/

# Presentation aids, not product code. The script generator and the Word document
# it produces are for one demo on one day; a binary that changes wholesale on every
# regeneration is no use in a diff, and the generator has no meaning without it.
scripts/make_demo_script.py
CivicTwin-demo-script.docx
